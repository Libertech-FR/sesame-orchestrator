# SESAME_LOG_LEVEL="info"
# Activer derrière le reverse-proxy Nuxt (proxy /api vers l'API)
# SESAME_TRUST_PROXY=1
# SESAME_NAME_QUEUE="sesame"
SESAME_JWT_SECRET="zeaezazeaezazaeeazrftrqezfqfqszewfsqddfqsqsqsdqdsqdsqdzsdqzsdqzs"
# Docker (make dev) : hostname du conteneur Redis sur le réseau dev
SESAME_REDIS_URI="redis://sesame-redis:6379/0"
# Local hors Docker : redis://localhost:6379/0
SESAME_MONGO_URI="mongodb://sesame-mongodb:27017/sesame"
# Adresse du frontal de changement de mot de passe
SESAME_FRONT_MDP="http://localhost:3000"
SESAME_IDENTITY_SYNC_MODE=manual
#module interne LDAP
SESAME_LDAP_ENABLED=true
SESAME_LDAP_URL=ldap://monldap
SESAME_LDAP_BIND_DN=cn=admin,dc=domain,dc=fr
SESAME_LDAP_BIND_PASSWORD=XXXXX
SESAME_LDAP_BASE_DN=dc=domain,dc=fr
SESAME_LDAP_STARTTLS=false
SESAME_LDAP_IMPORT_DEFAULT_DEPARTMENT=utilisateur
SESAME_LDAP_IMPORT_EMoui commit PLOYEE_TYPE=LOCAL
